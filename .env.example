# Client ID приложения: https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=

# User-токен аккаунта БОТА со scopes: chat:read chat:edit.
# Получить: открой в браузере и замени CLIENT_ID —
#   https://id.twitch.tv/oauth2/authorize?response_type=token&client_id=CLIENT_ID&redirect_uri=http://localhost&scope=chat:read%20chat:edit
# Нажми «Разрешить», в адресной строке будет access_token=… — скопируй его сюда.
# Важно: токен долен принадлежать аккаунту, под которым хочешь писать в чат.
TWITCH_ACCESS_TOKEN=

# Ник аккаунта бота (владелец токена выше) — под ним бот пишет в чат.
TWITCH_BOT_NAME=

# Каналы через запятую, без #. Например: my_channel,some_friend
TWITCH_CHANNELS=

# Тест с одного аккаунта: бот будет отвечать и на свои команды. Поставь 1.
TWITCH_REACT_TO_SELF=

# Хост и порт веб-сервера (SvelteKit + SSE). Для production: HOST=0.0.0.0, PORT=4311.
HOST=0.0.0.0
PORT=4311